{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxid Mail",
  "version": "0.8.3",
  "identifier": "io.smartholdem.oxidmail",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "yarn --cwd ../ui dev",
    "beforeBuildCommand": "yarn --cwd ../ui build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Oxid Mail // Zero-Server Client",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

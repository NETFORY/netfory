{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NETFORY",
  "version": "1.137.1",
  "identifier": "io.smartholdem.smartnet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NETFORY // SmartHoldem WEB4 P2P network",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$DATA/**",
          "$CACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "dev",
          "sth",
          "api"
        ]
      }
    }
  }
}

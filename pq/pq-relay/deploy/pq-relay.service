# /etc/systemd/system/pq-relay.service — режим A (TLS + ACME + QUIC в релее)
[Unit]
Description=SmartNet Relay (n1-relay, TLS + QUIC/QAD)
After=network-online.target
Wants=network-online.target

[Service]
User=pq-relay
Group=pq-relay
Environment=PQ_RELAY_DOMAIN=relay-fsn7.sth.cx
Environment=PQ_RELAY_ACME_CONTACT=mailto:ops@smartholdem.io
Environment=PQ_RELAY_ACME_CACHE=/var/lib/pq-relay/acme
Environment=PQ_RELAY_QUIC_PORT=7842
Environment=RUST_LOG=pq_relay=info,iroh_relay=info
# первый прогон: раскомментировать, затем убрать и очистить кэш ACME
#Environment=PQ_RELAY_ACME_STAGING=1
ExecStart=/opt/pq-relay/pq-relay
# bind 80/443 без root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
StateDirectory=pq-relay
# fd: каждый клиент релея = ≥1 дескриптор; дефолтные 1024 → EMFILE и «зависание»
LimitNOFILE=65535
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

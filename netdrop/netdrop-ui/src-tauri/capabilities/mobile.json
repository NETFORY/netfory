{
  "$schema": "https://schema.tauri.app/reference/acl/capability.json",
  "identifier": "mobile",
  "description": "netdrop mobile-only capabilities (Android share target + QR scanner)",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "sharetarget:default",
    "fs:default",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel",
    "barcode-scanner:allow-check-permissions",
    "barcode-scanner:allow-request-permissions"
  ]
}

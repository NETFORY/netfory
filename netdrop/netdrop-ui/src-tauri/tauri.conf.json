{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetDrop",
  "version": "0.8.11",
  "identifier": "cx.sth.netdrop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["netdrop"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P2P file transfer",
        "width": 540,
        "height": 760,
        "minWidth": 440,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
